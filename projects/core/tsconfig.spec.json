/* To learn more about this file see: https://angular.io/config/tsconfig. */
{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "baseUrl": "./",
    "outDir": "../../out-tsc/core-spec",
    "types": [
      "echarts",
      "vitest/globals"
    ],
    "paths": {
      "@ajf/core": ["."],
      "@ajf/core/*": ["./*"]
    }
  },
  "include": [
    "**/*.spec.ts",
    "**/*.d.ts"
  ],
  "exclude": [
    "cypress/**/*.ts"
  ]
}
